def itens_para_lista(texto):
    """Converte '2x Clássico Smash, 1x Milkshake' em lista estruturada."""
    lista = []
    for parte in texto.split(", "):
        parte = parte.strip()
        if not parte:
            continue
        m = re.match(r"^(\d+)x (.+)$", parte)
        if m:
            lista.append({"quantidade": int(m.group(1)), "produto": m.group(2)})
        else:
            lista.append({"quantidade": None, "produto": parte})
    return lista
 
 
def exportar_historico_json(caminho=ARQUIVO_JSON):
    """Exporta TODOS os pedidos para um arquivo JSON. Retorna (caminho_absoluto, qtd_pedidos)."""
    conexao = sqlite3.connect(DB_NAME)
    conexao.row_factory = sqlite3.Row
    linhas = conexao.execute(
        "SELECT id, cliente, usuario, data_hora, itens, total, cep, endereco, numero, forma_pagamento "
        "FROM pedidos ORDER BY id DESC"
    ).fetchall()
    conexao.close()
 
    pedidos = []
    for l in linhas:
        pedidos.append({
            "id": l["id"],
            "cliente": l["cliente"],
            "usuario": l["usuario"],
            "data_hora": l["data_hora"],
            "itens": itens_para_lista(l["itens"]),
            "itens_texto": l["itens"],
            "total": round(l["total"], 2),
            "cep": l["cep"],
            "endereco": l["endereco"],
            "numero": l["numero"],
            "forma_pagamento": l["forma_pagamento"],
        })
 
    dados = {
        "exportado_em": datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
        "total_pedidos": len(pedidos),
        "faturamento_total": round(sum(p["total"] for p in pedidos), 2),
        "pedidos": pedidos,
    }
 
    with open(caminho, "w", encoding="utf-8") as f:
        json.dump(dados, f, ensure_ascii=False, indent=2)
 
    return os.path.abspath(caminho), len(pedidos)
 
 
