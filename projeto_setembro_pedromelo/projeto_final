    def criar_area_rolavel(self, parent, cores):
        """Cria canvas com scroll (mouse wheel incluso) e largura ajustável."""
        canvas = tk.Canvas(parent, bg=cores["bg"], highlightthickness=0)
        scrollbar = ttk.Scrollbar(parent, orient="vertical", command=canvas.yview)
        conteudo = tk.Frame(canvas, bg=cores["bg"])
 
        janela_id = canvas.create_window((0, 0), window=conteudo, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
 
        conteudo.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(janela_id, width=e.width))
 
        def _rolar(event):
            if not canvas.winfo_exists():
                return
            if getattr(event, "num", None) == 4:
                canvas.yview_scroll(-1, "units")
            elif getattr(event, "num", None) == 5:
                canvas.yview_scroll(1, "units")
            else:
                canvas.yview_scroll(int(-event.delta / 120), "units")
 
        self.root.bind_all("<MouseWheel>", _rolar)
        self.root.bind_all("<Button-4>", _rolar)
        self.root.bind_all("<Button-5>", _rolar)
 
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        return conteudo
 
