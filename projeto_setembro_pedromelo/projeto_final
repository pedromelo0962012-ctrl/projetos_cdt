            messagebox.showwarning("Atenção", "Preencha o usuário e a senha.")
            return
 
        conexao = sqlite3.connect(DB_NAME)
        cursor = conexao.cursor()
        cursor.execute("SELECT nome, senha, perfil FROM usuarios WHERE usuario = ?", (usuario,))
        resultado = cursor.fetchone()
 
        ok = False
        if resultado:
            ok, atualizar = verificar_senha(senha, resultado[1])
            if ok and atualizar:
                cursor.execute("UPDATE usuarios SET senha = ? WHERE usuario = ?", (gerar_hash_senha(senha), usuario))
                conexao.commit()
        conexao.close()
 
        if ok:
            self.usuario_atual = usuario
            self.nome_atual = resultado[0]
            self.perfil_atual = resultado[2]
            self.carrinho.clear()
            self.mostrar_menu()
            if self.perfil_atual == "root":
                self.exportar_json_login()
        else:
            messagebox.showerror("Erro", "Usuário ou senha incorretos.")
 
