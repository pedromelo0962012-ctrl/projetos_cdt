def normalizar_texto(texto):
    texto = str(texto).lower().strip()
    texto = unicodedata.normalize("NFD", texto)
    texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
    texto = re.sub(r"[^a-z0-9\s,.]", " ", texto)
    return re.sub(r"\s+", " ", texto)
 
 
def formatar_moeda(valor):
    return f"R$ {valor:.2f}".replace(".", ",")
 
 
def restaurante_aberto():
    hora_atual = datetime.now().hour
    return INFO_RESTAURANTE["horario_abertura"] <= hora_atual < INFO_RESTAURANTE["horario_fechamento"]
 
 
def calcular_frete(subtotal):
    if subtotal >= INFO_RESTAURANTE["frete_gratis_acima"]:
        return 0.0
    return INFO_RESTAURANTE["frete_fixo"]
 
 
