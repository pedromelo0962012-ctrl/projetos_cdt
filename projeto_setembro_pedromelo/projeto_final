# SEGURANÇA DE SENHAS
# ============================================================
 
def gerar_hash_senha(senha):
    salt = os.urandom(16)
    h = hashlib.pbkdf2_hmac("sha256", senha.encode("utf-8"), salt, 100_000)
    return f"pbkdf2${salt.hex()}${h.hex()}"
 
 
def verificar_senha(senha, armazenada):
    """Retorna (ok, precisa_atualizar). Aceita senhas antigas em texto puro."""
    if armazenada.startswith("pbkdf2$"):
        try:
            _, salt_hex, hash_hex = armazenada.split("$")
            h = hashlib.pbkdf2_hmac("sha256", senha.encode("utf-8"), bytes.fromhex(salt_hex), 100_000)
            return hmac.compare_digest(h.hex(), hash_hex), False
        except ValueError:
            return False, False
    # Banco antigo: senha em texto puro -> valida e pede atualização para hash
    ok = hmac.compare_digest(senha.encode("utf-8"), armazenada.encode("utf-8"))
    return ok, ok
 
 
